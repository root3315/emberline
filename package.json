{
  "name": "emberline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A harmonized burning-activity calendar built from MODIS and VIIRS active fire detections.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "archive:fetch": "tsx scripts/build-archive.ts",
    "shots": "node scripts/shots.mjs",
    "audit": "node scripts/audit.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --temporary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
